{
  "author": "DarkPhilosophy",
  "description": "GNOME Shell extension showing battery percentage, time remaining, and real-time power consumption.",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "prettier": "^3.8.0"
  },
  "keywords": ["gnome", "extension", "battery", "power", "monitor"],
  "license": "GPL-3.0-or-later",
  "name": "batt-watt-power-monitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkPhilosophy/batt-watt-power-monitor.git"
  },
  "scripts": {
    "lint": "eslint extension .scripts .github/scripts test --format stylish",
    "lint:fix": "eslint --fix extension .scripts .github/scripts test --format stylish",
    "lint:status": "node .scripts/update-lint-status.mjs",
    "package": "./package.sh",
    "sync:gnome-badge": "node .scripts/sync-gnome-badge.mjs",
    "test": "node --test test/*.test.mjs",
    "test:gjs": "gjs -m test/utils.gjs.mjs",
    "validate": "node .scripts/validate-build.mjs && node .scripts/scan-leaks.mjs && node .scripts/detect-duplicate-symbols.mjs"
  },
  "type": "module",
  "version": "23.0.0"
}
